# The canonical URL NextAuth builds OAuth callbacks from.
# Local development: http://localhost:3000
# Production (Vercel): set this to your deployed origin, e.g. https://your-app.vercel.app
# In BOTH cases the Spotify dashboard must list the matching redirect URI exactly:
#   <NEXTAUTH_URL>/api/auth/callback/spotify
NEXTAUTH_URL=http://localhost:3000

# Any random 32+ byte string. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# From https://developer.spotify.com/dashboard -> your app -> Settings.
# The Client ID is 32 hex characters, e.g. 4f1a9c2e8b7d40f3a6c15e9d2b8074af
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
